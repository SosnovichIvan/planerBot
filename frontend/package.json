{
  "name": "planerbot-mini-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.cypress.json",
    "lint": "eslint . && steiger src --watch=false",
    "test": "vitest run --coverage",
    "build:check": "tsc --noEmit && vite build",
    "generate:api": "openapi-typescript ../backend/openapi.json -o src/shared/api/schema.d.ts",
    "e2e": "start-server-and-test 'npm run dev -- --port 4173 --strictPort' http://127.0.0.1:4173 'e2e:run'",
    "e2e:run": "cypress run --browser electron",
    "e2e:open": "cypress open --e2e",
    "e2e:trace": "node scripts/check-scenarios.mjs"
  },
  "dependencies": {
    "openapi-fetch": "^0.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@feature-sliced/steiger-plugin": "^0.5.6",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^4.0.0",
    "cypress": "15.21.1",
    "cypress-real-events": "1.15.1",
    "eslint": "^9.39.0",
    "eslint-plugin-import-x": "^4.16.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "openapi-typescript": "^7.10.0",
    "start-server-and-test": "3.0.13",
    "steiger": "^0.5.8",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
