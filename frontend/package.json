{
  "name": "planerbot-mini-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=24.12.0"},
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && steiger src --watch=false",
    "test": "vitest run --coverage",
    "build:check": "tsc --noEmit && vite build",
    "generate:api": "openapi-typescript ../backend/openapi.json -o src/shared/api/schema.d.ts"
  },
  "dependencies": {
    "react": "^19.2.0", "react-dom": "^19.2.0", "openapi-fetch": "^0.14.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0", "vite": "^7.2.0", "@vitejs/plugin-react": "^5.1.0",
    "tailwindcss": "^4.1.0", "@tailwindcss/vite": "^4.1.0",
    "vitest": "^4.0.0", "@vitest/coverage-v8": "^4.0.0", "jsdom": "^27.0.0",
    "@testing-library/react": "^16.3.0", "@testing-library/user-event": "^14.6.0",
    "@testing-library/jest-dom": "^6.9.0", "@types/react": "^19.2.0", "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0", "@eslint/js": "^9.39.0", "typescript-eslint": "^8.46.0",
    "eslint-plugin-react-hooks": "^7.0.0", "eslint-plugin-import-x": "^4.16.0",
    "globals": "^16.4.0", "steiger": "^0.5.8", "@feature-sliced/steiger-plugin": "^0.5.6",
    "openapi-typescript": "^7.10.0"
  }
}
