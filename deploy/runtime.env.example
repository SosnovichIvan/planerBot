# Root-only /etc/planerbot/runtime.env. Never commit real values.
# Use a NEW token issued after the token disclosed in chat was revoked.
BOT_TOKEN=
# At least 32 random hexadecimal characters; keep unchanged once DB is initialized.
POSTGRES_PASSWORD=
# Operator acceptance of Let's Encrypt subscriber agreement for IP issuance.
ACME_AGREE_TOS=no
