# Obtain from @BotFather. Never commit a real token.
BOT_TOKEN=
# Optional HTTP CONNECT proxy. Empty means direct; a configured proxy never falls back.
TELEGRAM_PROXY_URL=
# HTTPS URL configured as Main Mini App in @BotFather.
WEBHOOK_SECRET=
DATABASE_URL=postgresql+asyncpg://planerbot:local-development@localhost:55432/planerbot
INIT_DATA_TTL_SECONDS=300
# Private numeric Telegram user ID, not @username. 0 disables support intake.
SUPPORT_CHAT_ID=0
